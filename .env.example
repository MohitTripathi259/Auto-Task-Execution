# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=local                        # local | prod
LOG_LEVEL=INFO

# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_PLANNER_MODEL=claude-sonnet-4-6
CLAUDE_EXECUTOR_MODEL=claude-sonnet-4-6

# ─── AWS (use dummy values for local / LocalStack) ────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566   # remove in prod

# ─── Storage ──────────────────────────────────────────────────────────────────
S3_BUCKET=agent-artifacts
DYNAMODB_TABLE_EVENTS=agent_events

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://agent:agent@localhost:5432/agentdb

# ─── SQS ──────────────────────────────────────────────────────────────────────
SQS_TASK_QUEUE_URL=http://localhost:4566/000000000000/agent-tasks.fifo
SQS_VISIBILITY_TIMEOUT=300

# ─── ECS (not needed for local Docker mode) ───────────────────────────────────
ECS_CLUSTER=agent-cluster
ECS_TASK_DEFINITION=agent-executor
# ECS_SUBNET_IDS=subnet-xxx,subnet-yyy
# ECS_SECURITY_GROUP_IDS=sg-xxx

# ─── GitHub ───────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...

# ─── Notifications (stub for demo) ────────────────────────────────────────────
SES_FROM_EMAIL=agent@example.com
ALERT_EMAIL=you@example.com

# ─── Budget defaults ──────────────────────────────────────────────────────────
DEFAULT_MAX_RUNTIME_MINUTES=60
DEFAULT_MAX_TOOL_CALLS=40
DEFAULT_MAX_COST_USD=8.0
DEFAULT_MAX_INPUT_TOKENS=120000
DEFAULT_MAX_OUTPUT_TOKENS=25000
